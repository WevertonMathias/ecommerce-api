# Copie este arquivo para ".env" e ajuste os valores conforme necessário.
# O arquivo ".env" NUNCA deve ser commitado (já está no .gitignore).

# Banco de dados PostgreSQL
POSTGRES_DB=ecommerce
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_PORT=5432

# Aplicação Spring Boot
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/ecommerce
SPRING_DATASOURCE_USERNAME=admin
SPRING_DATASOURCE_PASSWORD=admin123

# JWT
JWT_SECRET=troque-este-valor-por-uma-chave-secreta-bem-grande-e-aleatoria
JWT_EXPIRATION_MS=3600000
